# Local-only demo controls. Set CAUSALFLY_FAKE_META=1 in the server shell for
# offline Muse templates. SAM stays live unless you choose Load OFFLINE SAM FIXTURE.
# META_API_KEY is server-only; never use NEXT_PUBLIC_ or commit .env.local.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-wonder-1.0
META_SCENE_MODEL=muse-spark-1.3
META_TIMEOUT_MS=120000

# Server only. Verified read-only research stream; no connection without configuration.
# The brain control endpoint is separate and must not be used here.
# Local only: ws://127.0.0.1:8766/observatory/v1
# Production: leave empty until Sprint 11B provides a remote wss:// URL.
FRUITFLY_XR_OBSERVATORY_URL=

# Offline Muse templates only; scene/SAM use explicit fixture actions.
# Leave unset for live alpha, or set 1 for an explicitly labelled offline demo.
CAUSALFLY_FAKE_META=
