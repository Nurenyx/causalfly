# Local-only demo controls. Set CAUSALFLY_FAKE_META=1 in the server shell for
# fully offline templates. Live scene/SAM are also blocked in fake mode.
# META_API_KEY is server-only; never use NEXT_PUBLIC_ or commit .env.local.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-wonder-1.0
META_SCENE_MODEL=muse-spark-1.3
META_TIMEOUT_MS=120000

# Server-side read-only observatory telemetry; separate from experimental control.
# No connection without configuration. Local: ws://127.0.0.1:8766/observatory/v1
# Production: configure a verified secure wss:// endpoint (temporary Funnel allowed).
FRUITFLY_XR_OBSERVATORY_URL=

# Browser-visible experimental sensory/control transport, NOT a secret.
# Never include credentials, bearer tokens, API keys, query strings or signed secrets.
# Set before next build: NEXT_PUBLIC_ values are frozen in the browser bundle.
# Production requires wss://HOST/brain/v1; missing/invalid means no neural input.
# Development only: ws://127.0.0.1:8765/brain/v1 or ws://localhost:8765/brain/v1
# Neither endpoint launches the FruitFly XR headset application.
NEXT_PUBLIC_FRUITFLY_XR_BRAIN_URL=

# Explicitly labelled offline mode; the primary perception actions load fixtures.
# Set 1 for offline. Live additionally requires CAUSALFLY_META_ENABLED=1.
CAUSALFLY_FAKE_META=

# Authoritative live provider permission. Missing/0 disables all live Muse/SAM calls.
CAUSALFLY_META_ENABLED=0

# Connect a PRIVATE Vercel Blob store. Vercel supplies rotating project OIDC.
BLOB_STORE_ID=
# Optional server-only fallback for local/non-Vercel hosts; never NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=
# Independent random secret, at least 32 characters; stable across instances/redeploys.
CAUSALFLY_MEDIA_SIGNING_SECRET=
# Operator bearer secret for POST /api/media/cleanup. No automatic TTL is configured.
CRON_SECRET=

# Raw developer JSON export: production is hidden by default; development is visible.
# Set 1 intentionally for internal use, or 0 to hide in development too.
# CAUSALFLY_DEVELOPER_DIAGNOSTICS=1
